# Copy to .env and adjust, or just export these before running.
# Every value below is the built-in default.

# --- engine ---------------------------------------------------------------
NIMBUS_ENGINE=ollama                          # ollama | llamacpp | mock
NIMBUS_MODEL=qwen2.5:3b-instruct-q4_K_M
OLLAMA_HOST=http://127.0.0.1:11434
# NIMBUS_GGUF_PATH=C:/models/qwen2.5-3b-instruct-q4_k_m.gguf   # llamacpp only

# --- inference ------------------------------------------------------------
NIMBUS_FORCE_CPU=1            # 0 layers offloaded to GPU; the assignment requires CPU-only
NIMBUS_NUM_THREADS=0          # 0 = let the runtime choose
NIMBUS_TEMPERATURE=0.3
NIMBUS_TOP_P=0.9
NIMBUS_MAX_OUTPUT_TOKENS=320
NIMBUS_CONTEXT_WINDOW=4096

# --- context memory -------------------------------------------------------
NIMBUS_HISTORY_TOKEN_BUDGET=1400
NIMBUS_MIN_VERBATIM_TURNS=2
NIMBUS_ENABLE_ROLLING_SUMMARY=1
NIMBUS_SUMMARY_MAX_TOKENS=160

# --- sessions and limits --------------------------------------------------
NIMBUS_SESSION_TTL_SECONDS=3600
NIMBUS_MAX_SESSIONS=500
NIMBUS_MAX_MESSAGE_CHARS=2000
NIMBUS_MAX_CONCURRENT_GENERATIONS=4
NIMBUS_GENERATION_TIMEOUT=180

# --- server ---------------------------------------------------------------
NIMBUS_HOST=127.0.0.1
NIMBUS_PORT=8000
NIMBUS_CORS=*
